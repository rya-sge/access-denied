digraph CCM {
graph [bgcolor=white, splines=line, pad=0.3, fontname="Helvetica", fontsize=15, labelloc=t,
       label=<<B>CCM generation-encryption at block level (NIST SP 800-38C, Section 6.1)</B>>];
node [fontname="Helvetica", fontsize=12, style=filled, penwidth=1.3];
edge [color="#4B3A70", arrowsize=0.7, fontname="Helvetica", fontsize=11, fontcolor="#4B3A70"];
h1 [pos="4.2,8.35!", shape=plaintext, style="", fontsize=14, fontcolor="#4B3A70", label=<<B>1. CBC-MAC over the formatted blocks B<SUB>0</SUB> … B<SUB>r</SUB> (zero IV)</B>>];
h2 [pos="4.2,5.35!", shape=plaintext, style="", fontsize=14, fontcolor="#4B3A70", label=<<B>2. Counter-mode encryption: payload with S<SUB>1</SUB> … S<SUB>m</SUB>, MAC with S<SUB>0</SUB></B>>];
B0 [pos="0.6,6.3!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<B<SUB>0</SUB><BR/><FONT POINT-SIZE="10">flags | N | Q</FONT>>];
E0 [pos="2.1,6.3!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
X1 [pos="3.6,6.3!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
B1 [pos="3.6,7.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<B<SUB>1</SUB><BR/><FONT POINT-SIZE="10">len(A) | start of A</FONT>>];
E1 [pos="5.0,6.3!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
d1 [pos="6.2,6.3!", shape=plaintext, style="", label="· · ·", fontsize=16];
Xu [pos="7.4,6.3!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
Bu [pos="7.4,7.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<B<SUB>u+1</SUB><BR/><FONT POINT-SIZE="10">P, block 1</FONT>>];
Eu [pos="8.8,6.3!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
d2 [pos="10.0,6.3!", shape=plaintext, style="", label="· · ·", fontsize=16];
Xr [pos="11.2,6.3!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
Br [pos="11.2,7.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<B<SUB>r</SUB><BR/><FONT POINT-SIZE="10">P, last block, 0-padded</FONT>>];
Er [pos="12.6,6.3!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
T [pos="14.6,6.3!", shape=box, style="rounded,filled", fillcolor="#FFF4D6", color="#B08A2E", label=<<B>T</B> = MSB<SUB>Tlen</SUB>(Y<SUB>r</SUB>)<BR/><FONT POINT-SIZE="10">MAC, never sent in clear</FONT>>];
C1 [pos="2.4,4.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<Ctr<SUB>1</SUB><BR/><FONT POINT-SIZE="10">flags | N | [1]</FONT>>];
F1 [pos="2.4,3.5!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
Z1 [pos="2.4,2.5!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
P1 [pos="0.7999999999999998,2.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<P, block 1>];
O1 [pos="2.4,1.5!", shape=box, style="rounded,filled", fillcolor="#EAF6F0", color="#2E8B67", label=<C<SUB>1</SUB>>];
Cm [pos="7.4,4.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<Ctr<SUB>m</SUB><BR/><FONT POINT-SIZE="10">flags | N | [m]</FONT>>];
Fm [pos="7.4,3.5!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
Zm [pos="7.4,2.5!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
Pm [pos="5.800000000000001,2.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<P, last block<BR/><FONT POINT-SIZE="10">S<SUB>m</SUB> truncated if partial</FONT>>];
Om [pos="7.4,1.5!", shape=box, style="rounded,filled", fillcolor="#EAF6F0", color="#2E8B67", label=<C<SUB>m</SUB>>];
d3 [pos="4.9,3.0!", shape=plaintext, style="", label="· · ·", fontsize=16];
d4 [pos="4.9,1.5!", shape=plaintext, style="", label="· · ·", fontsize=16];
C0 [pos="12.6,4.5!", shape=box, fillcolor="#F3EEFB", color="#7A5BB5", label=<Ctr<SUB>0</SUB><BR/><FONT POINT-SIZE="10">flags | N | [0]</FONT>>];
F0 [pos="12.6,3.5!", shape=box, style="filled", fillcolor="#7A5BB5", color="#4B3A70", fontcolor=white, width=1.0, height=0.45, label=<CIPH<SUB>K</SUB>>];
Z0 [pos="12.6,2.5!", shape=circle, fillcolor=white, color="#4B3A70", label="⊕", width=0.36, height=0.36, fixedsize=true, fontsize=17];
O0 [pos="12.6,1.5!", shape=box, style="rounded,filled", fillcolor="#EAF6F0", color="#2E8B67", label=<T ⊕ MSB<SUB>Tlen</SUB>(S<SUB>0</SUB>)<BR/><FONT POINT-SIZE="10">encrypted MAC</FONT>>];
OUT [pos="7.4,0.25!", shape=box, style="rounded,filled,bold", fillcolor="#EAF6F0", color="#2E8B67", label=<<B>Ciphertext C</B> = C<SUB>1</SUB> || … || C<SUB>m</SUB> || encrypted MAC<BR/><FONT POINT-SIZE="10">length Plen + Tlen bits</FONT>>];
B0->E0;
E0->X1 [label=<Y<SUB>0</SUB>>];
B1->X1;
X1->E1;
E1->d1 [label=<Y<SUB>1</SUB>>];
d1->Xu;
Bu->Xu;
Xu->Eu;
Eu->d2;
d2->Xr;
Br->Xr;
Xr->Er;
Er->T [label=<Y<SUB>r</SUB>>];
T->Z0 [color="#B08A2E", penwidth=1.6];
C1->F1;
F1->Z1 [label=<S<SUB>1</SUB>>];
P1->Z1;
Z1->O1;
Cm->Fm;
Fm->Zm [label=<S<SUB>m</SUB>>];
Pm->Zm;
Zm->Om;
C0->F0;
F0->Z0 [label=<S<SUB>0</SUB>>];
Z0->O0;
O1->OUT;
Om->OUT;
O0->OUT;
}