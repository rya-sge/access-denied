@startuml
title Checking whether data follow a power law
skinparam shadowing false
skinparam activity {
  BackgroundColor #EAF6F0
  BorderColor #2E8B67
}
start
:Plot the data on log-log axes;
if (Roughly straight over several decades?) then (yes)
  :Choose the lower cutoff x_min of the tail;
  :Estimate the exponent by maximum likelihood;
  :Goodness-of-fit test (KS distance, bootstrap);
  if (p-value high enough?) then (yes)
    :Compare against lognormal and exponential\nwith a likelihood-ratio test;
    :Report exponent, x_min and range;
  else (no)
    :Not a power law;<<#FDEEEE>>
  endif
else (no)
  :Not a power law over this range;<<#FDEEEE>>
endif
stop
@enduml
