@startuml
title Ethereum system contracts and who talks to them
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5

actor "Solidity contract or EOA" as User
component "Execution client\n(caller SYSTEM_ADDRESS\n0xff...fe)" as Client
component "Consensus layer\n(beacon state)" as CL

package "Read by users, written by the client" {
  component "EIP-4788 beacon roots\n0x000F3df6...Beac02" as BR
  component "EIP-2935 block hashes\n0x0000F908...002935" as BH
}

package "Written by users, drained by the client" {
  component "EIP-7002 withdrawals\n0x00000961...007002" as WQ
  component "EIP-7251 consolidations\n0x0000BBdD...007251" as CQ
}

package "No system call" {
  component "Deposit contract\n0x00000000...7705Fa\n(logs scanned, EIP-6110)" as DC
}

Client --> BR : start of block,\nunchecked
Client --> BH : start of block,\nunchecked
Client --> WQ : end of block,\nchecked
Client --> CQ : end of block,\nchecked
User --> BR : read
User --> BH : read
User --> WQ : request + fee
User --> CQ : request + fee
User --> DC : deposit()
DC ..> Client : DepositEvent logs
Client --> CL : requests list,\ncommitted by requests_hash
@enduml
