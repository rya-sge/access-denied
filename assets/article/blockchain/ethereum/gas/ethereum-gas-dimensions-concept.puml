@startuml
title Gas of one transaction: Fusaka vs Glamsterdam
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
rectangle "Fusaka (Osaka rules)" as F {
  rectangle "Gas limit <= 16,777,216" as FL
  rectangle "Intrinsic gas" as FI
  rectangle "Execution gas\n(includes 20,000 per new slot)" as FE
  FL --> FI
  FL --> FE
}
rectangle "Glamsterdam (Amsterdam rules)" as G {
  rectangle "Gas limit (up to 2^32 - 1)" as GL
  rectangle "Intrinsic gas" as GI
  rectangle "Execution gas\n<= 16,777,216 - intrinsic" as GE
  rectangle "State gas reservoir\n(gas limit - 16,777,216)" as GR
  rectangle "State gas\n1,530 per byte\n(97,920 per new slot)" as GS
  GL --> GI
  GL --> GE
  GL --> GR
  GR --> GS : first
  GE ..> GS : when reservoir empty
}
@enduml
