@startuml
title Modular Account V2 — where the owner lives in each variant
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5

package "SMA-Bytecode  (cheapest deploy)" {
  [ERC-1967 proxy\n+ owner as immutable arg] as PB
  [SemiModularAccountBytecode] as IB
  PB --> IB : delegatecall
}
note bottom of PB
  Owner read from proxy bytecode.
  Not a valid upgrade target.
end note

package "SMA-StorageOnly  (upgrade target)" {
  [ERC-1967 proxy] as PS
  [SemiModularAccountStorageOnly] as IS
  PS --> IS : delegatecall
}
note bottom of PS
  Owner in ERC-7201 namespaced storage,
  set by initialize() via upgradeToAndCall.
end note

package "SMA-7702  (delegated EOA)" {
  [EOA address\nwith 7702 delegation] as PE
  [SemiModularAccount7702] as IE
  PE --> IE : delegate
}
note bottom of PE
  Fallback signer defaults to address(this):
  the EOA stays its own owner.
  upgradeToAndCall is disabled.
end note

package "ModularAccount  (fully modular)" {
  [ERC-1967 proxy] as PM
  [ModularAccount] as IM
  [SingleSigner or\nWebAuthn module] as MOD
  PM --> IM : delegatecall
  IM --> MOD : validation
}
note bottom of PM
  No fallback validation.
  Ownership lives entirely in modules.
end note

' force a 2x2 layout instead of one very wide row
IB -[hidden]down- PE
IS -[hidden]down- PM
@enduml
