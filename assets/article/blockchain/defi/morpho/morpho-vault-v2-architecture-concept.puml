@startuml
title Morpho Vault V2 - contracts and roles
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component { 
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam actor {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
actor Depositor
actor Curator
actor Allocator
actor Sentinel
actor Owner
component "VaultV2\nshares, _totalAssets,\ncaps per id, fees, timelocks" as V
component "MorphoMarketV1AdapterV2" as A1
component "MorphoVaultV1Adapter" as A2
component "Morpho Blue markets" as M
component "MetaMorpho vault" as MM
component "Adapter registry" as R
component "Gates (x4)" as G
Depositor --> V : deposit / withdraw /\nforceDeallocate
Owner --> V : setCurator, setIsSentinel
Curator --> V : submit / revoke\ndecrease caps
Allocator --> V : allocate / deallocate\nliquidity adapter, maxRate
Sentinel --> V : deallocate, revoke,\ndecrease caps
V --> A1 : allocate / deallocate
V --> A2 : allocate / deallocate
A1 --> M
A2 --> MM
V ..> R : isInRegistry
V ..> G : canSend / canReceive
@enduml
