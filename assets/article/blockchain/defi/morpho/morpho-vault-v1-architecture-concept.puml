@startuml
title Morpho Vault V1 (MetaMorpho) - contracts and roles
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam actor {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
actor Depositor
actor Owner
actor Curator
actor Allocator
actor Guardian
component "MetaMorpho vault\nsupplyQueue, withdrawQueue,\ncaps, timelock, lastTotalAssets" as V
component "Morpho Blue singleton" as B
component "Market A" as MA
component "Market B" as MB
component "Idle market" as MI
component "Skim recipient\n(rewards distributor)" as SK
Depositor --> V : deposit / withdraw
Owner --> V : fee, curator, allocators,\ntimelock, guardian
Curator --> V : submitCap,\nsubmitMarketRemoval
Allocator --> V : setSupplyQueue,\nupdateWithdrawQueue, reallocate
Guardian --> V : revoke pending changes
V --> B : supply / withdraw
B --> MA
B --> MB
B --> MI
V ..> SK : skim(token)
@enduml
