@startuml
title Morpho Blue - one contract, isolated markets
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam actor {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
actor Supplier
actor Borrower
actor Liquidator
actor Owner
package "Morpho (singleton)" {
  component "Market id = keccak256(params)\ntotals: supply/borrow assets and shares\nlastUpdate, fee" as M
  component "Positions per account\nsupplyShares, borrowShares, collateral" as P
}
component "Oracle\nprice x 1e36" as O
component "IRM\nborrowRate per second" as I
Supplier --> M : supply / withdraw
Borrower --> M : supplyCollateral, borrow,\nrepay, withdrawCollateral
Liquidator --> M : liquidate
Owner ..> M : enableIrm, enableLltv,\nsetFee (<= 25%)
M --> P
M ..> O : health check, liquidation
M ..> I : accrueInterest
@enduml
