@startuml
title Centrifuge V3 vault architecture (spoke side, with hub counterpart)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5

actor Investor

package "Spoke chain" {
  component "VaultRouter\n(multicall entry point)" as Router
  component "AsyncVault\nERC-7540" as AsyncVault
  component "SyncDepositVault\nERC-4626 + ERC-7540 redeem" as SyncVault
  component "AsyncRequestManager\nper-investor request state" as ARM
  component "SyncManager\nprice + maxReserve" as SM
  component "BalanceSheet\nissue / revoke / note" as BS
  component "PoolEscrow\ntotal + reserved" as Escrow
  component "ShareToken\nERC-20 + ERC-1404" as Share
  component "Transfer hook\nFullRestrictions, ..." as Hook
  component "VaultRegistry\ndeploy / link / unlink" as Registry
}

package "Hub chain" {
  component "BatchRequestManager\nepochs, approvals" as BRM
  component "Hub\naccounting, prices" as Hub
}

Investor --> Router
Investor --> AsyncVault
Investor --> SyncVault
Router --> AsyncVault
Router --> SyncVault
AsyncVault --> ARM
SyncVault --> SM
SyncVault --> ARM : redeem path
ARM --> BS
SM --> BS
BS --> Escrow
BS --> Share
Share --> Hook : checkTransferRestriction
Registry --> AsyncVault : link
Registry --> SyncVault : link
ARM ..> BRM : request message
BRM ..> ARM : callback message
BRM --> Hub
@enduml
