@startuml
title How the hook classifies a share movement
skinparam shadowing false
skinparam ArrowColor #4A78B5
skinparam activity {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #4A78B5
}

start
:ShareToken calls hook with
from, to, value, hookData;

if (source or target frozen?) then (yes)
  :block transfer;<<#FFFFFF>>
  stop
else (no)
endif

if (from == address(0)?) then (yes)
  if (to is the pool escrow?) then (yes)
    :deposit fulfilment
    always allowed;
  else (no)
    :deposit request or issuance
    target must be a member;
  endif
elseif (to == ESCROW_HOOK_ID?) then (yes)
  :redeem request
  source must be a member;
elseif (from is the pool escrow?) then (yes)
  :deposit claim
  target must be a member;
elseif (to == address(0)?) then (yes)
  :redeem fulfilment, claim
  or cross-chain burn;
elseif (from == crosschain source?) then (yes)
  :cross-chain execution
  target must be a member;
else (no)
  :ordinary transfer
  target must be a member;
endif

:allow or block per policy;
stop
@enduml
