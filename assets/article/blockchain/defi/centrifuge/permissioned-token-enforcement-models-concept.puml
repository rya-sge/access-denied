@startuml
title Where the compliance decision is made
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5

package "Centrifuge model" {
  component "ShareToken\ntransfer, transferFrom,\nmint, burn" as CT
  component "Balance slot\namount + hookData\nvalidUntil, freeze bit" as CS
  component "Transfer hook\none contract,\nswappable per token" as CH
  CT --> CS : same storage slot,\nno extra read
  CT --> CH : onERC20Transfer\n(from, to, value, hookData)
  CH --> CH : infer operation from\nsentinel addresses
}

package "ERC-3643 model" {
  component "Token\ntransfer, transferFrom,\nmint, forcedTransfer" as TT
  component "IdentityRegistry\nisVerified(address)" as TR
  component "ONCHAINID\nclaims + trusted issuers" as TO
  component "Compliance\ncanTransfer, transferred,\ncreated, destroyed" as TC
  component "Modules\nholder caps, country\nlimits, volume rules" as TM
  TT --> TR : who may hold
  TR --> TO
  TT --> TC : is this transfer allowed
  TC --> TM
}

note bottom of CH #EEF5FF
  One contract answers both
  "who" and "which operation"
end note

note bottom of TC #EEF5FF
  Identity and global rules
  answered by separate contracts
end note
@enduml
