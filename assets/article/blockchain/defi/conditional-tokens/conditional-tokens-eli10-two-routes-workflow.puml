@startuml
title Two routes to the same sticker
skinparam shadowing false
skinparam ArrowColor #4A78B5
skinparam activity {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #4A78B5
  StartColor #4A78B5
  EndColor #4A78B5
}
skinparam note {
  BackgroundColor #F7FAFF
  BorderColor #4A78B5
}

start
:You have 1 coin;

if (Which question first?) then (the race)
  :Swap the coin for\n"ALICE WINS", "BOB WINS", "CAROL WINS";
  :Keep "ALICE WINS";
  :Swap "ALICE WINS" for\n"ALICE + RAIN" and "ALICE + DRY";
  :Keep "ALICE + RAIN";
else (the weather)
  :Swap the coin for\n"RAIN" and "DRY";
  :Keep "RAIN";
  :Swap "RAIN" for\n"ALICE + RAIN", "BOB + RAIN", "CAROL + RAIN";
  :Keep "ALICE + RAIN";
endif

#EEF5FF:You are holding a sticker
that says ALICE + RAIN;

note right
  Both routes end on the very same
  serial number, so the two stickers
  are the same sticker. You can swap
  one for the other, or sell it to
  someone who took the other route.
end note

stop
@enduml
