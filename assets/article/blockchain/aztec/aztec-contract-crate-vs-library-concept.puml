@startuml
title What a contract crate keeps and what a library crate can hold
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}

package "restricted_token_lib  (type = lib)" as lib {
  rectangle "Module structs\nPausable, Freezable, TransferLists\nimpl StateVariable<N, Context>\nimpl per context (public / private)" as mods
  rectangle "Chain functions\ntransfer_private(balances, screening, ..)\nmint_private(..), burn_private(..)\nrequire_not_paused(pausable)" as chains
  rectangle "Screening trait\nimpl for FreezeAndLists\nimpl for FreezeOnly" as trait
}

package "restricted_token  (type = contract)" as full {
  rectangle "aztec contract RestrictedToken\n\nstorage: Storage { pausable, freeze, lists, balances, supply }\nevent: Transfer\nexternal: transfer / mint / burn (+ attributes)\nonly_self: _assert_not_paused\nenqueue_self, emit\nscreening(storage) -> FreezeAndLists" as fullc
}

package "restricted_token_light  (type = contract)" as light {
  rectangle "aztec contract RestrictedTokenLight\n\nstorage: Storage { pausable, freeze, balances, supply }\nevent: Transfer\nexternal: transfer / mint / burn (+ attributes)\nonly_self: _assert_not_paused\nenqueue_self, emit\nscreening(storage) -> FreezeOnly" as lightc
}

fullc --> chains : passes its state\nvariables by value
lightc --> chains
fullc --> trait : implements with lists
lightc --> trait : implements freeze only
chains --> trait : generic over S: Screening
fullc ..> mods : holds as storage fields
lightc ..> mods

note bottom of lib
  Everything here is ordinary Noir: no entry points,
  no storage of its own, no events. Inlined into the
  callers' circuits, so the gate counts do not change.
end note
@enduml
