@startuml
title A mint before and after the delayed issuer address becomes current
skinparam shadowing false
skinparam activity {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
  DiamondBackgroundColor #EEF5FF
  DiamondBorderColor #4A78B5
}

start
:constructor schedules issuer_address;<<#EEF5FF>>
note right
  Scheduled, not written: the value
  becomes current only after the delay.
end note

if (has the delay elapsed?) then (no - the dead window)
  :issuer_address reads as zero;<<#FDEEEE>>
  if (issuer copy delivered how?) then (offchain, before the audit change)
    :random secret, undiscoverable tag;<<#FDEEEE>>
    :mint SUCCEEDS,
    issuer receives nothing usable;<<#FDEEEE>>
  else (onchain_constrained, after it)
    :panic on the tagging secret;<<#FDEEEE>>
    :mint REVERTS at simulation;<<#FDEEEE>>
  endif
else (yes)
  :issuer_address reads as the admin;<<#EAF6F0>>
  :note to the holder, constrained;<<#EAF6F0>>
  :note copy to the issuer, offchain;<<#EAF6F0>>
  :Transfer event to the issuer, constrained;<<#EAF6F0>>
  :mint succeeds, issuer has an on-chain record;<<#EAF6F0>>
endif
stop
@enduml
