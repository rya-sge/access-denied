@startuml
title Components of an Aztec browser-extension wallet
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor white
  BorderColor #4A78B5
}
rectangle "Web page (dApp)" as D {
  component "@aztec/wallet-sdk\nWalletManager" as SDK
}
rectangle "Extension" as X {
  component "Content script\nrelays messages, holds no key" as CS
  component "Background service worker\nBackgroundConnectionHandler:\ndiscovery, ECDH session, approvals, routing" as BG
  component "Popup UI\nconnect / verify emojis / approve tx" as UI
  rectangle "Offscreen document (WASM, IndexedDB)" as OFF {
    component "BaseWallet subclass\naccounts, completeFeeOptions, sendTx" as W
    component "PXE\nkey store, note DB,\nsimulator, hooks" as PXE
    component "Prover (bb.js)\nproveTx" as PR
    component "Encrypted key storage\nPBKDF2 + AES-GCM" as KS
  }
}
component "Aztec node\nlogs by tag, tx submission" as N
SDK <--> CS : postMessage (encrypted)
CS <--> BG : chrome.runtime messages
BG <--> UI : pending approvals
BG <--> W : persistent port
W --> PXE
W --> PR
W --> KS
PXE <--> N : sync, sendTx
@enduml
