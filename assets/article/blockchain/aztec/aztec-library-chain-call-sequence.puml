@startuml
title A private transfer through the library chain
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 240
skinparam sequence {
  ParticipantBackgroundColor #EEF5FF
  ParticipantBorderColor #4A78B5
  LifeLineBorderColor #4A78B5
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}

actor Holder
box "Contract crate — the aztec contract block" #F4F8FC
participant "transfer(from, to, amount, nonce)\nauthorize_once, external private" as Ext
participant "screening(storage)\ncontract_library_method" as Scr
end box
box "Library crate — ordinary Noir" #FFFFFF
participant "transfer_private<S: Screening>\n(balances, screening, from, to, amount)" as Chain
participant "S = FreezeAndLists\n(this variant's impl)" as Impl
end box
box "Contract crate — public phase" #FFF8E8
participant "_assert_not_paused()\nonly_self" as Pub
end box

Holder -> Ext : transfer(from, to, amount, nonce)
Ext -> Ext : authwit check (macro-generated)
Ext -> Scr : screening(self.storage)
Scr --> Ext : FreezeAndLists { freeze, lists }
Ext -> Chain : transfer_private(self.storage.balances, screening, from, to, amount)
Chain -> Impl : screening.transfer(from, to)
Impl -> Impl : assert not frozen(from), not frozen(to)\nlists.check(from, to)
Impl --> Chain : ok
Chain -> Chain : balances.at(from).sub(amount).deliver(..)\nbalances.at(to).add(amount).deliver(..)
Chain --> Ext : ok
note over Chain, Impl
  Monomorphised and inlined: the circuit of `transfer` is the same
  as if this code had been written inside the entry point.
end note
Ext -> Pub : enqueue_self._assert_not_paused()
Ext -> Ext : emit(Transfer { from, to, amount }).deliver_to(to, ..)
== Public phase ==
Pub -> Pub : assert !pausable.is_paused()
@enduml
