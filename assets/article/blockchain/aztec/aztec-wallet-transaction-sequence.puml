@startuml
title A transaction through an Aztec wallet
skinparam shadowing false
skinparam sequence {
  ParticipantBackgroundColor #EEF5FF
  ParticipantBorderColor #4A78B5
  LifeLineBorderColor #4A78B5
}
skinparam note {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
participant "dApp" as D
participant "Background worker" as B
participant "User (popup)" as U
participant "BaseWallet (offscreen)" as W
participant "Account contract\n(entrypoint)" as A
participant "PXE" as P
participant "Node" as N
D -> B : sendTx(ExecutionPayload, {from})\nover the encrypted session
B -> U : pending approval, badge
U --> B : approve
B -> W : forward over the port
W -> W : completeFeeOptions\n(Sponsored FPC / FPC / Fee Juice)
W -> A : build TxExecutionRequest\n(account signs the calls)
W -> P : simulate (kernelless)
P --> W : gas estimate + authwit requests
W -> A : sign captured authwits
W -> P : proveTx (WASM, 10-60 s)
P --> W : proven tx
W -> N : send
N --> W : tx hash
W --> B : result
B --> D : encrypted response
@enduml
