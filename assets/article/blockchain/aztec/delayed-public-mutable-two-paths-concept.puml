@startuml
title Two ways for a private transfer to honour a public pause flag
skinparam shadowing false
skinparam componentStyle rectangle
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}

rectangle "Private function\n**transfer(to, amount)**\nproved on the sender's device\nagainst the anchor block" as priv

rectangle "Option 1\n**PublicMutable<bool> paused**" as opt1 {
  rectangle "enqueue_self\n_assert_not_paused()\nonly_self attribute" as enq
  rectangle "Public phase, in the block\nreads current value\nreverts the whole tx if paused" as pub
}

rectangle "Option 2\n**DelayedPublicMutable<bool, DELAY> paused**" as opt2 {
  rectangle "get_current_value()\nhistorical read at anchor block\n~4k constraints" as read
  rectangle "set_expiration_timestamp(\n  anchor + DELAY, or the\n  scheduled change timestamp)" as exp
}

priv --> enq
enq --> pub
priv --> read
read --> exp

note bottom of opt1
  Immediate. Publishes that this tx
  called this contract (address, selector,
  args), not who sent it.
end note

note bottom of opt2
  Fully private execution. Publishes an
  expiration timestamp; the tx must be
  included before the value may change.
end note
@enduml
