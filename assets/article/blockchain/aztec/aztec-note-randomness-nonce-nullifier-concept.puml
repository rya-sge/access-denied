@startuml
title Three values in one note, three sources, three properties
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor white
  BorderColor #4A78B5
}
rectangle "Creator's device\n(oracle random())" as A
rectangle "Protocol\n(kernel circuits)" as B
rectangle "Owner's keys\n(nsk_app)" as K
component "randomness r\n→ H(owner, r)\n→ note_hash" as R
component "note nonce\nH(first_nullifier, index)\n→ unique_note_hash" as N
component "nullifier\nH(note_hash_for_nullification, nsk_app)" as Z
A --> R
B --> N
K --> Z
note bottom of R
  Hides owner and value.
  Secret until delivered
  to the owner. Chosen by
  the creator, unconstrained.
end note
note bottom of N
  Uniqueness of the leaf.
  Public and recomputable.
  Hides nothing.
end note
note bottom of Z
  Marks the spend.
  Unlinkable through the
  secret key, not through r.
end note
@enduml
