@startuml
title Coprocessor services and their channels
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam database {
  BackgroundColor #F3F7FD
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor white
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5
left to right direction

package "Host chain" {
  component "FHEVMExecutor\nACL\nKMSGeneration" as host
}
package "Gateway (Arbitrum rollup)" {
  component "InputVerification" as gwin
  component "CiphertextCommits" as gwcc
}

package "Coprocessor node" {
  component "host-listener\n(WebSocket)" as hl
  component "host-listener-poller\n(HTTP, finality lag)" as hlp
  component "gw-listener" as gwl
  database "PostgreSQL\ncomputations, ciphertexts,\nallowed_handles, dependence_chain,\nverify_proofs, ciphertext_digest,\ntransactions" as db
  component "tfhe-worker\nTFHE-rs, 64 FHE threads" as tw
  component "zkproof-worker\nZKPoK verification" as zk
  component "sns-worker\nswitch-and-squash" as sns
  component "tx-sender\nAWS KMS key" as tx
  component "S3 bucket\n(public, Cloudflare hostname)" as s3
}

host --> hl : events
host --> hlp : blocks
gwin --> gwl : VerifyProofRequest
hl --> db : computations,\nallowed_handles
hlp --> db
gwl --> db : verify_proofs\nNOTIFY event_zkpok_new_work
db --> tw : acquire dependence chain
tw --> db : ciphertexts\nNOTIFY event_ciphertext_computed
db --> zk : event_zkpok_new_work
zk --> db : verified, handles\nNOTIFY event_zkpok_computed
db --> sns : event_ciphertext_computed,\nevent_pbs_computations
sns --> s3 : regular + squashed ciphertexts
sns --> db : ciphertext_digest\nNOTIFY event_ciphertexts_uploaded
db --> tx : event_zkpok_computed,\nevent_ciphertexts_uploaded
tx --> gwin : signed attestation
tx --> gwcc : addCiphertextMaterial
@enduml
