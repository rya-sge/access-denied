@startuml
title Coprocessor deployment on EKS (coprocessor-operator, mainnet values)
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor white
  BorderColor #4A78B5
}
skinparam database {
  BackgroundColor #F3F7FD
  BorderColor #4A78B5
}
skinparam cloud {
  BackgroundColor #F7F7F7
  BorderColor #4A78B5
}
skinparam ArrowColor #4A78B5

package "EKS cluster" {
  package "coprocessor-pool (Karpenter)" {
    component "tfhe-worker\n88 CPU / 128 GiB" as tw
    component "zkproof-worker\n48 CPU / 128 GiB" as zk
    component "sns-worker\n48 CPU / 128 GiB" as sns
  }
  package "zws-pool (Karpenter)" {
    component "eth-blockchain ns\nhost-listener + poller" as eth
    component "polygon-blockchain ns\nhost-listener + poller" as pol
    component "gw-blockchain ns\ngw-listener, tx-sender" as gw
    component "coproc-admin ns\ndb jobs, operator-check" as adm
    component "monitoring ns\nAlloy, exporters" as mon
  }
}

cloud "AWS" {
  database "RDS PostgreSQL\ncoprocessor db" as rds
  component "S3 bucket\n+ Cloudflare hostname" as s3
  component "KMS key\nsecp256k1" as kms
  component "Secrets Manager\nRDS master credentials" as sm
}

cloud "External" {
  component "Ethereum / Polygon RPC\n(HTTPS + WSS)" as rpc
  component "Gateway RPC\n(Conduit)" as gwrpc
  component "hub.zama.org\nimages" as hub
  component "Grafana Cloud" as graf
}

tw --> rds
zk --> rds
sns --> rds
sns --> s3 : IRSA
eth --> rds
pol --> rds
gw --> rds
adm --> sm : IRSA db-admin
adm --> rds : role setup, checks
gw --> kms : IRSA tx-sender
eth --> rpc
pol --> rpc
gw --> gwrpc
mon --> graf : OTLP, Prometheus, Loki
hub ..> tw : pull
@enduml
