@startuml
title Where a transient value lives
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component { 
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BorderColor #4A78B5
}
package "One transaction" {
  component "Frame: proxy" as P
  component "Frame: implementation\n(DELEGATECALL)" as I
  component "Frame: other contract\n(CALL)" as O
  component "Transient space of the proxy" as TP
  component "Transient space of the other contract" as TO
}
component "Next transaction: empty" as N
P --> TP : TSTORE, TLOAD
I --> TP : caller's space
O --> TO : own space
TP ..> N : discarded
TO ..> N : discarded
@enduml
