@startuml
title Medusa — fuzzing lifecycle of a single worker
skinparam shadowing false
skinparam ArrowColor #4A78B5
skinparam activity {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #4A78B5
}

start
:Compile project (crytic-compile or solc);
:Deploy targetContracts from deployerAddress;
:Snapshot the initial deployment state;<<#DDEBFF>>

repeat
  if (random draw < newSequenceProbability) then (yes)
    :Generate a fully random call sequence;
  else (no)
    :Select a corpus entry;
    :Apply a mutation strategy
    (head, tail, splice, interleave);<<#DDEBFF>>
  endif

  :i = 0;
  repeat
    :Execute call i on the TestChain;
    :Update coverage maps from the CoverageTracer;
    if (new branch covered?) then (yes)
      :Add sequence[0..i] to the corpus;<<#DDEBFF>>
    else (no)
    endif
    :Run assertion, property and
    optimization test functions;
    if (test failed or improved?) then (yes)
      :Emit a ShrinkCallSequenceRequest;<<#FDEEEE>>
      :Shrink while the verifier still reproduces;<<#FDEEEE>>
      :Report the minimised sequence and trace;<<#FDEEEE>>
    else (no)
    endif
    :i = i + 1;
  repeat while (i < callSequenceLength?) is (yes)
  -> no;

  :Reset the chain to the initial deployment state;
repeat while (testLimit / timeout not reached?) is (yes)
-> no;

:Flush corpus to disk;
:Generate coverage and revert reports;
stop

@enduml
