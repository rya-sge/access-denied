@startuml
title Medusa — introducing a fuzzing campaign into a Solidity project
skinparam shadowing false
skinparam ArrowColor #4A78B5
skinparam activity {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #4A78B5
}

start
:Run medusa init in the project root;
:Set fuzzing.targetContracts to the harness contract;<<#DDEBFF>>
:Set fuzzing.testLimit and fuzzing.corpusDirectory;

:Write the harness contract;
split
  :Function-level checks
  (fuzzed arguments + assert);
split again
  :System-level checks
  (property_ functions, no arguments);
split again
  :Wrapper functions that clamp
  fuzzed inputs to valid ranges;
end split

:Run medusa fuzz --config medusa.json;

if (campaign reports a failure?) then (yes)
  :Read the shrunk call sequence and trace;<<#FDEEEE>>
  :Reproduce as a Foundry unit test;<<#FDEEEE>>
  :Fix the contract or the property;<<#FDEEEE>>
else (no)
  :Open corpus/coverage/coverage_report.html;
  if (coverage of the target is adequate?) then (no)
    :Inspect the revert report;
    :Loosen clamps, add wrappers,
    lengthen callSequenceLength;
    detach
  else (yes)
  endif
endif

:Commit the corpus and wire the campaign into CI;
stop

@enduml
