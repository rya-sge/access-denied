@startuml
title What the bytes of a solc build commit to
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component { 
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BorderColor #4A78B5
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}

package "Inputs" {
  component "Source files" as SRC
  component "Compiler version" as VER
  component "Effective settings\n(pipeline, optimizer, runs, EVM target)" as SET
}

package "Metadata JSON" {
  component "sources: keccak256, URLs" as MS
  component "compiler, settings" as MC
  component "output: ABI, devdoc, userdoc" as MO
}

package "Runtime bytecode" {
  component "Executable code, final fe" as CODE
  component "CBOR map: ipfs or bzzr1, solc" as CBOR
  component "Length suffix: 2 bytes" as LEN
}

SRC --> MS : hashed
SRC --> MO : NatSpec
VER --> MC
SET --> MC
SRC --> CODE : logic
SET --> CODE : changes the code
VER --> CODE
MS --> CBOR : CID v0 of the file
MC --> CBOR
MO --> CBOR
VER --> CBOR : solc bytes
CBOR --> LEN : its length

note bottom of CODE
  A factory embeds the child's creation code
  and so the child's own trailer.
  Deployment writes immutables and library addresses here.
end note
@enduml
