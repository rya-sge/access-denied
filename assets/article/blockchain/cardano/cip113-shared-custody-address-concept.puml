@startuml
title Programmable-token addresses: one payment credential, many owners
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Helvetica
skinparam rectangle {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #4A78B5
}

package "programmable_logic_base address space" {
  rectangle "addr(PLB, stake_alice)\n120 USDX + min ADA" as A
  rectangle "addr(PLB, stake_bob)\n40 USDX + min ADA" as B
  rectangle "addr(PLB, script_dex)\n900 USDX + min ADA" as C
}

rectangle "Payment credential\nPLB script hash\nshared by every holder" as PC #DCE9FA
rectangle "Stake credential slot\nvkey hash or script hash\nidentifies the owner" as SC #DCE9FA

PC -[#4A78B5]-> A
PC -[#4A78B5]-> B
PC -[#4A78B5]-> C
SC .[#4A78B5].> A : stake_alice
SC .[#4A78B5].> B : stake_bob
SC .[#4A78B5].> C : script_dex

note bottom of PC
  Every spend from this credential
  runs the same spending validator,
  so one rule set covers all holders.
end note

note bottom of SC
  A transfer rewrites this slot
  and leaves the payment
  credential untouched.
end note
@enduml
