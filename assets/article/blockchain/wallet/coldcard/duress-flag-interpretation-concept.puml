@startuml
title Where each trick-PIN flag is interpreted
skinparam shadowing false
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #FDEEEE
  BorderColor #B54A4A
}
skinparam package {
  BackgroundColor #FFFAFA
  BorderColor #B54A4A
}
skinparam note {
  BackgroundColor #EEF5FF
  BorderColor #4A78B5
}
skinparam ArrowColor #B54A4A

package "SE2 - 14 trick slots" {
  component "hashed PIN\n+ tc_flags + tc_arg\n+ up to 64 bytes xdata" as SLOT
}

package "Bootloader (C, unchangeable)" {
  component "TC_WIPE 0x8000" as W
  component "TC_BRICK 0x4000" as B
  component "TC_FAKE_OUT 0x2000" as F
  component "TC_WORD_WALLET 0x1000" as WW
  component "TC_XPRV_WALLET 0x0800" as XW
}

package "MicroPython (replaceable)" {
  component "TC_DELTA_MODE 0x0400" as D
  component "TC_REBOOT 0x0200" as R
  component "TC_FW_DEFINED 0x0100\n(e.g. spending-policy unlock)" as FW
  component "TC_BLANK_WALLET 0x0080" as BW
  component "TC_COUNTDOWN 0x0040\ntc_arg = minutes" as C
}

SLOT --> W
SLOT --> B
SLOT --> F
SLOT --> WW
SLOT --> XW
SLOT --> D
SLOT --> R
SLOT --> FW
SLOT --> BW
SLOT --> C

note bottom of F
  TC_HIDDEN_MASK = 0xf800
  these five bits are stripped before
  the result reaches MicroPython:
  the wallet code cannot report
  what it was never told
end note

note bottom of C
  bits below the mask are passed up,
  because the application has to act
  on them (countdown UI, delta-mode
  restrictions, policy bypass)
end note
@enduml
