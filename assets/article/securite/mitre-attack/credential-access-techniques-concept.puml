@startuml
title Acquiring credentials, then abusing them
skinparam shadowing false
skinparam componentStyle rectangle
skinparam PackageBackgroundColor #FDEEEE
skinparam PackageBorderColor #B54A4A
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #B54A4A
skinparam RectangleBackgroundColor #FBE3E3
skinparam RectangleBorderColor #B54A4A

package "Credential Access" as CA {
  component "T1110 Brute Force" as BF
  component "T1110.001\nPassword Guessing" as PG
  component "T1110.003\nPassword Spraying" as PS
  PG -up-> BF
  PS -up-> BF
}

rectangle "Valid credentials\n(username + password)" as CREDS

package "Initial Access / Persistence /\nPrivilege Escalation / Defense Evasion" as USE {
  component "T1078 Valid Accounts" as VA
}

BF --> CREDS : produce
CREDS --> VA : consumed by

note bottom of USE
  Valid Accounts also accepts credentials from
  OS Credential Dumping (T1003) and Phishing (T1566)
end note
@enduml
