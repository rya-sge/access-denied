@startuml
title From guessing a password to abusing an account
skinparam shadowing false
skinparam ActivityBackgroundColor #FDEEEE
skinparam ActivityBorderColor #B54A4A
skinparam ActivityDiamondBackgroundColor #FBE3E3
skinparam ActivityDiamondBorderColor #B54A4A
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #B54A4A

start
:Enumerate accounts and exposed services;
if (Lockout policy in force?) then (yes)
  :Password Spraying;<<#FBE3E3>>
  note right: T1110.003 - one common password across many accounts
else (no / offline hashes)
  :Password Guessing / Cracking;<<#FBE3E3>>
  note right: T1110.001 - many passwords against one account
endif
if (Valid credentials found?) then (yes)
  :Authenticate as a legitimate user;<<#FBE3E3>>
  note right: T1078 Valid Accounts - VPN, OWA, RDP, SaaS
  :Persist, escalate, and blend in;
  note right: reuse across local / domain / cloud accounts to reach admin
else (no)
  :Throttle and retry / change target;
  stop
endif
:Access without malware, hard to detect;
stop
@enduml
